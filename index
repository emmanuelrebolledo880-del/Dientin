<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Diente Saltarín - Juego Educativo</title>
    <!-- Tailwind CSS para diseño responsivo y utilidades rápidas -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Fuente Google Fonts amigable y redondeada -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        /* Estilos personalizados y animaciones para el juego */
        body {
            font-family: 'Fredoka', sans-serif;
            background: linear-gradient(135deg, #e0f7fa 0%, #e8f5e9 100%);
            overflow-x: hidden;
            touch-action: manipulation;
            user-select: none;
        }

        /* Efecto de botón estilo burbuja 3D */
        .btn-bubble {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 5px 0 rgba(0, 0, 0, 0.15);
        }
        .btn-bubble:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 7px 0 rgba(0, 0, 0, 0.15);
        }
        .btn-bubble:active:not(:disabled) {
            transform: translateY(3px);
            box-shadow: 0 2px 0 rgba(0, 0, 0, 0.15);
        }

        /* Animación flotante para el diente en el menú */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(3deg); }
        }
        .animate-float {
            animation: float 3s ease-in-out infinite;
        }

        /* Animación de sacudida al fallar */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }

        /* Canvas responsivo */
        #gameCanvas {
            display: block;
            width: 100%;
            height: 100%;
            border-radius: 1.25rem;
        }

        /* Barra de progreso suave */
        #dangerBar {
            transition: width 0.1s linear, background-color 0.3s ease;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-2 sm:p-4 text-slate-700">

    <!-- Contenedor Principal del Juego -->
    <div id="appContainer" class="w-full max-w-4xl bg-white/90 backdrop-blur-md rounded-3xl shadow-2xl border-4 border-teal-200 overflow-hidden flex flex-col relative">
        
        <!-- Barra Superior (HUD) -->
        <header class="bg-gradient-to-r from-teal-400 via-emerald-400 to-cyan-400 p-3 sm:p-4 text-white flex flex-wrap items-center justify-between gap-2 shadow-md z-10">
            <div class="flex items-center gap-2">
                <span class="text-2xl sm:text-3xl filter drop-shadow">🦷</span>
                <h1 class="text-xl sm:text-2xl font-bold tracking-wide drop-shadow-sm">Diente Saltarín</h1>
            </div>

            <!-- Marcadores -->
            <div id="hudStats" class="flex items-center gap-3 sm:gap-5 text-sm sm:text-base font-bold">
                <!-- Progreso de preguntas -->
                <div id="progressBadge" class="hidden bg-white/25 px-3 py-1 rounded-full items-center gap-1.5 shadow-inner" title="Progreso de preguntas">
                    <span>📋</span>
                    <span id="progressDisplay">1/10</span>
                </div>
                <!-- Vidas -->
                <div class="bg-white/25 px-3 py-1 rounded-full flex items-center gap-1 shadow-inner" title="Vidas restantes">
                    <span id="livesDisplay" class="tracking-widest text-base sm:text-lg">❤️❤️❤️</span>
                </div>
                <!-- Puntuación -->
                <div class="bg-white/25 px-3 py-1 rounded-full flex items-center gap-1.5 shadow-inner">
                    <span>⭐</span>
                    <span id="scoreDisplay">0</span>
                </div>
                <!-- Racha -->
                <div class="bg-white/25 px-3 py-1 rounded-full flex items-center gap-1.5 shadow-inner hidden sm:flex" title="Racha de aciertos">
                    <span>🔥</span>
                    <span id="streakDisplay">0</span>
                </div>
                <!-- Botón Sonido -->
                <button id="soundToggleBtn" class="bg-white/30 hover:bg-white/40 p-2 rounded-full transition active:scale-90" title="Activar/Silenciar sonido" aria-label="Sonido">
                    <span id="soundIcon" class="text-lg leading-none">🔊</span>
                </button>
            </div>
        </header>

        <!-- Área Visual del Escenario (Canvas) -->
        <div class="relative w-full h-56 sm:h-64 md:h-72 bg-sky-100 border-b-4 border-teal-100 overflow-hidden">
            <canvas id="gameCanvas"></canvas>
            
            <!-- Indicador de Proximidad del Obstáculo (Barra de tiempo visual) -->
            <div id="dangerMeterContainer" class="hidden absolute top-3 left-1/2 -translate-x-1/2 w-11/12 max-w-md bg-white/80 backdrop-blur-sm p-1.5 rounded-full shadow-md border border-teal-200">
                <div class="flex justify-between text-xs font-bold px-2 mb-0.5 text-slate-600">
                    <span>¡Responde antes de chocar!</span>
                    <span id="obstacleNameTag" class="text-rose-500">Caramelo</span>
                </div>
                <div class="w-full h-2.5 bg-slate-200 rounded-full overflow-hidden">
                    <div id="dangerBar" class="h-full bg-emerald-400 rounded-full" style="width: 100%;"></div>
                </div>
            </div>

            <!-- Etiqueta flotante de retroalimentación (+100, ¡Ouch!, etc.) -->
            <div id="floatingFeedback" class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300">
                <span id="floatingText" class="text-3xl sm:text-5xl font-extrabold text-white drop-shadow-[0_4px_4px_rgba(0,0,0,0.4)] transform scale-75 transition-transform duration-300"></span>
            </div>
        </div>

        <!-- Panel Inferior: Preguntas y Opciones (Durante el juego) -->
        <main id="questionPanel" class="hidden p-4 sm:p-6 bg-gradient-to-b from-white to-teal-50/60 flex-1 flex flex-col justify-between">
            <div class="mb-4 text-center">
                <span id="categoryBadge" class="inline-block bg-teal-100 text-teal-700 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2">
                    Salud Bucodental
                </span>
                <h2 id="questionText" class="text-lg sm:text-2xl font-bold text-slate-800 leading-snug">
                    ¿Qué es el edentulismo?
                </h2>
            </div>

            <!-- Cuadrícula de Opciones Múltiples -->
            <div id="optionsGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-3xl mx-auto w-full">
                <!-- Los botones de respuesta se inyectan dinámicamente aquí -->
            </div>
        </main>

        <!-- Pantalla de Inicio (Estado Inicial) -->
        <section id="startScreen" class="p-6 sm:p-8 bg-white flex flex-col items-center text-center">
            <div class="w-20 h-20 sm:w-24 sm:h-24 bg-teal-50 rounded-full flex items-center justify-center border-4 border-teal-200 shadow-inner mb-3 animate-float">
                <span class="text-5xl sm:text-6xl">🦷</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-teal-600 mb-2">¡Ayuda a Dientín a esquivar las caries!</h2>
            <p class="text-slate-600 max-w-lg text-sm sm:text-base mb-6">
                Dulces, refrescos y bacterias se acercan rápidamente. <strong>Responde correctamente las 10 preguntas sobre salud bucodental</strong> antes de que lleguen para que Dientín dé un salto brillante y sume puntos.
            </p>

            <!-- Botón Jugar -->
            <button id="startBtn" class="btn-bubble bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-500 hover:to-teal-600 text-white font-extrabold text-xl px-10 py-4 rounded-full tracking-wide flex items-center gap-3">
                <span>¡JUGAR AHORA!</span>
                <span class="text-2xl">🚀</span>
            </button>
        </section>

        <!-- Pantalla de Game Over / Victoria -->
        <section id="gameOverScreen" class="hidden p-6 sm:p-8 bg-white flex flex-col items-center text-center">
            <div id="endEmoji" class="text-6xl mb-2">😵‍💫🦷</div>
            <h2 id="endTitle" class="text-3xl font-extrabold text-rose-500 mb-1">¡Oh no! Muchas caries</h2>
            <p id="endSubtitle" class="text-slate-500 mb-6">¡Pero hiciste un gran esfuerzo protegiendo la sonrisa!</p>

            <!-- Tarjeta de Resumen -->
            <div class="grid grid-cols-3 gap-3 sm:gap-6 w-full max-w-md bg-teal-50/80 border-2 border-teal-200 rounded-2xl p-4 mb-6">
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase">Puntuación</p>
                    <p id="finalScore" class="text-2xl sm:text-3xl font-extrabold text-teal-600">0</p>
                </div>
                <div class="border-x border-teal-200">
                    <p class="text-xs font-bold text-slate-400 uppercase">Aciertos</p>
                    <p id="finalCorrect" class="text-2xl sm:text-3xl font-extrabold text-emerald-500">0 / 10</p>
                </div>
                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase">Mejor Racha</p>
                    <p id="finalStreak" class="text-2xl sm:text-3xl font-extrabold text-amber-500">0</p>
                </div>
            </div>

            <div class="flex flex-wrap justify-center gap-3">
                <button id="restartBtn" class="btn-bubble bg-gradient-to-r from-emerald-400 to-teal-500 text-white font-extrabold text-lg px-8 py-3.5 rounded-full flex items-center gap-2">
                    <span>🔄 Jugar de nuevo</span>
                </button>
                <button id="menuBtn" class="btn-bubble bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-lg px-6 py-3.5 rounded-full">
                    🏠 Inicio
                </button>
            </div>
        </section>

    </div>

    <!-- Pie de página discreto -->
    <footer class="mt-3 text-xs text-slate-500 text-center">
        Responde rápido (clic o teclas A/B - 1/2) para saltar • ¡Mantén tu racha para ganar puntos extra!
    </footer>

    <script>
        /**
         * ============================================================================
         * 1. BANCO DE PREGUNTAS EDUCATIVAS (10 Preguntas exactas del PDF)
         * ============================================================================
         */
        const QUESTION_BANK = [
            {
                categoryLabel: '🦷 Salud Bucodental',
                question: '¿Qué es el edentulismo?',
                options: ['La inflamación de las encías.', 'La pérdida parcial o total de los dientes.'],
                correct: 1
            },
            {
                categoryLabel: '👵 Salud en Adultos Mayores',
                question: '¿Cuál es la afección bucodental más común en personas mayores?',
                options: ['Caries', 'Pérdida dental'],
                correct: 1
            },
            {
                categoryLabel: '🧠 Bienestar Integral',
                question: 'Las afecciones bucodentales pueden afectar a nivel fisiológico,...',
                options: ['Psicológico', 'Biológico'],
                correct: 0
            },
            {
                categoryLabel: '🪥 Higiene Bucal',
                question: '¿Es suficiente usar cepillo y pasta dental para una buena higiene bucal?',
                options: ['Verdadero', 'Falso'],
                correct: 1
            },
            {
                categoryLabel: '✨ Cuidado de Prótesis',
                question: '¿Cuál es la limpieza correcta de su prótesis dental?',
                options: ['Enjuagarla con agua y jabón', 'Limpiarla con productos adecuados'],
                correct: 1
            },
            {
                categoryLabel: '🍎 Nutrición y Masticación',
                question: 'La pérdida de dientes puede dificultar la alimentación y la masticación.',
                options: ['Verdadero', 'Falso'],
                correct: 0
            },
            {
                categoryLabel: '⚙️ Función Bucal',
                question: '¿Qué problemas funcionales pueden presentarse debido a las afecciones bucodentales?',
                options: ['Alteración masticatoria', 'Sensibilidad dental'],
                correct: 0
            },
            {
                categoryLabel: '😌 Salud Emocional',
                question: 'Los problemas de salud bucodental pueden provocar estrés o ansiedad',
                options: ['Verdadero', 'Falso'],
                correct: 0
            },
            {
                categoryLabel: '🩺 Prevención Médica',
                question: 'Consecuencias que puede generar una mala higiene bucal',
                options: ['No tiene relación con la salud', 'Aumentar el riesgo de neumonía por aspiración'],
                correct: 1
            },
            {
                categoryLabel: '🗓️ Prevención Odontológica',
                question: 'Es importante acudir a revisiones odontológicas periódicas',
                options: ['Verdadero', 'Falso'],
                correct: 0
            }
        ];

        /**
         * ============================================================================
         * 2. MOTOR DE AUDIO SINTETIZADO (Web Audio API - Sin archivos externos)
         * ============================================================================
         */
        class SoundFX {
            constructor() {
                this.ctx = null;
                this.muted = false;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (AudioContext) {
                        this.ctx = new AudioContext();
                    }
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playJump() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;

                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(260, now);
                osc.frequency.exponentialRampToValueAtTime(680, now + 0.28);

                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.3);
            }

            playSuccess() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;

                const notes = [523.25, 659.25, 783.99]; // Do5, Mi5, Sol5
                notes.forEach((freq, idx) => {
                    const now = this.ctx.currentTime + idx * 0.07;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.25);
                });
            }

            playVictory() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;

                const notes = [523.25, 659.25, 783.99, 1046.50]; // Do5, Mi5, Sol5, Do6
                notes.forEach((freq, idx) => {
                    const now = this.ctx.currentTime + idx * 0.1;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now);
                    gain.gain.setValueAtTime(0.22, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.35);
                });
            }

            playHit() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;

                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(190, now);
                osc.frequency.linearRampToValueAtTime(75, now + 0.35);

                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.36);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.36);
            }

            playGameOver() {
                if (this.muted) return;
                this.init();
                if (!this.ctx) return;

                const notes = [392.00, 349.23, 329.63, 261.63];
                notes.forEach((freq, idx) => {
                    const now = this.ctx.currentTime + idx * 0.16;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now);
                    gain.gain.setValueAtTime(0.22, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.3);
                });
            }
        }

        const sfx = new SoundFX();

        /**
         * ============================================================================
         * 3. REFERENCIAS AL DOM Y ESTADO DEL JUEGO
         * ============================================================================
         */
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const appContainer = document.getElementById('appContainer');

        // Pantallas y paneles
        const startScreen = document.getElementById('startScreen');
        const questionPanel = document.getElementById('questionPanel');
        const gameOverScreen = document.getElementById('gameOverScreen');
        const dangerMeterContainer = document.getElementById('dangerMeterContainer');
        const dangerBar = document.getElementById('dangerBar');
        const obstacleNameTag = document.getElementById('obstacleNameTag');

        // HUD
        const progressBadge = document.getElementById('progressBadge');
        const progressDisplay = document.getElementById('progressDisplay');
        const livesDisplay = document.getElementById('livesDisplay');
        const scoreDisplay = document.getElementById('scoreDisplay');
        const streakDisplay = document.getElementById('streakDisplay');
        const soundToggleBtn = document.getElementById('soundToggleBtn');
        const soundIcon = document.getElementById('soundIcon');

        // Preguntas
        const categoryBadge = document.getElementById('categoryBadge');
        const questionText = document.getElementById('questionText');
        const optionsGrid = document.getElementById('optionsGrid');

        // Feedback flotante
        const floatingFeedback = document.getElementById('floatingFeedback');
        const floatingText = document.getElementById('floatingText');

        // Variables de estado de partida
        let gameState = 'START'; // 'START', 'PLAYING', 'GAMEOVER'
        let score = 0;
        let lives = 3;
        let streak = 0;
        let bestStreak = 0;
        let correctCount = 0;
        let currentQuestion = null;
        let questionAnswered = false;
        let questionOrder = [];
        let currentQuestionIndex = 0;

        // Dimensiones lógicas del canvas
        let width = 800;
        let height = 260;
        let groundY = 205;

        // Entidades del juego
        const tooth = {
            x: 115,
            y: 0,
            vy: 0,
            width: 54,
            height: 62,
            isGrounded: true,
            runPhase: 0,
            emotion: 'happy', // 'happy', 'jump', 'hurt'
            emotionTimer: 0
        };

        const OBSTACLE_TYPES = [
            { name: 'Caramelo Pegajoso', type: 'candy', color: '#f43f5e' },
            { name: 'Refresco Azucarado', type: 'soda', color: '#3b82f6' },
            { name: 'Bacteria de Caries', type: 'germ', color: '#8b5cf6' },
            { name: 'Pastelito Dulce', type: 'cupcake', color: '#ec4899' }
        ];

        let obstacle = {
            active: false,
            x: 900,
            startX: 900,
            y: 0,
            width: 46,
            height: 46,
            speed: 140,
            info: OBSTACLE_TYPES[0],
            resolved: false
        };

        // Elementos decorativos de fondo (nubes, brillos y partículas)
        let clouds = [];
        let particles = [];
        let groundOffset = 0;
        let lastTimestamp = 0;

        /**
         * ============================================================================
         * 4. CONFIGURACIÓN RESPONSIVA DEL CANVAS
         * ============================================================================
         */
        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            width = rect.width;
            height = rect.height;
            groundY = height - 48;
            tooth.x = Math.max(70, Math.min(130, width * 0.16));

            if (tooth.isGrounded) {
                tooth.y = groundY - tooth.height;
            }
        }

        function initDecorations() {
            clouds = [
                { x: width * 0.2, y: 35, scale: 0.9, speed: 18 },
                { x: width * 0.6, y: 55, scale: 0.7, speed: 12 },
                { x: width * 0.88, y: 28, scale: 1.0, speed: 22 }
            ];
        }

        window.addEventListener('resize', resizeCanvas);

        /**
         * ============================================================================
         * 5. LÓGICA DEL JUEGO Y PREGUNTAS
         * ============================================================================
         */
        function buildQuestionOrder() {
            questionOrder = QUESTION_BANK.map((_, index) => index);
            for (let i = questionOrder.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [questionOrder[i], questionOrder[j]] = [questionOrder[j], questionOrder[i]];
            }
            currentQuestionIndex = 0;
        }

        function startGame() {
            sfx.init();
            score = 0;
            lives = 3;
            streak = 0;
            bestStreak = 0;
            correctCount = 0;
            particles = [];
            buildQuestionOrder();

            tooth.vy = 0;
            tooth.isGrounded = true;
            tooth.y = groundY - tooth.height;
            tooth.emotion = 'happy';

            gameState = 'PLAYING';

            startScreen.classList.add('hidden');
            gameOverScreen.classList.add('hidden');
            questionPanel.classList.remove('hidden');
            dangerMeterContainer.classList.remove('hidden');
            progressBadge.classList.remove('hidden');
            progressBadge.classList.add('flex');

            updateHUD();
            spawnNextTurn();
        }

        function spawnNextTurn() {
            if (gameState !== 'PLAYING') return;

            // Si ya se completaron las 10 preguntas del PDF, ¡victoria!
            if (currentQuestionIndex >= questionOrder.length) {
                endGame(true);
                return;
            }

            // Actualizar indicador de progreso (ej. 1/10)
            progressDisplay.textContent = `${currentQuestionIndex + 1}/${questionOrder.length}`;

            // Obtener pregunta actual y avanzar índice
            const qIndex = questionOrder[currentQuestionIndex];
            currentQuestionIndex++;
            currentQuestion = QUESTION_BANK[qIndex];
            questionAnswered = false;

            // Renderizar pregunta en UI
            categoryBadge.textContent = currentQuestion.categoryLabel;
            questionText.textContent = currentQuestion.question;
            optionsGrid.innerHTML = '';

            const optionLetters = ['A', 'B'];
            currentQuestion.options.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn-bubble bg-white hover:bg-teal-50 border-2 border-teal-200 text-slate-700 font-bold py-3.5 px-4 rounded-2xl text-left flex items-center gap-3 text-sm sm:text-base transition-colors cursor-pointer';
                btn.innerHTML = `
                    <span class="w-8 h-8 rounded-full bg-teal-100 text-teal-700 font-extrabold flex items-center justify-center shrink-0 text-sm">${optionLetters[idx]}</span>
                    <span class="leading-tight">${optText}</span>
                `;
                btn.addEventListener('click', () => handleAnswer(idx, btn));
                optionsGrid.appendChild(btn);
            });

            // Configurar nuevo obstáculo
            const randomObs = OBSTACLE_TYPES[Math.floor(Math.random() * OBSTACLE_TYPES.length)];
            obstacle.info = randomObs;
            obstacle.active = true;
            obstacle.resolved = false;
            obstacle.startX = width + 50;
            obstacle.x = obstacle.startX;
            obstacle.y = groundY - obstacle.height;

            // Velocidad progresiva suave según preguntas respondidas (da tiempo cómodo para leer)
            const distance = obstacle.startX - (tooth.x + tooth.width * 0.5);
            const timeAvailable = Math.max(8.5, 13.0 - currentQuestionIndex * 0.35);
            obstacle.speed = distance / timeAvailable;

            obstacleNameTag.textContent = randomObs.name;
            dangerBar.style.width = '100%';
            dangerBar.className = 'h-full bg-emerald-400 rounded-full';
        }

        function handleAnswer(selectedIndex, clickedBtn) {
            if (gameState !== 'PLAYING' || questionAnswered) return;
            questionAnswered = true;

            const buttons = optionsGrid.querySelectorAll('button');
            buttons.forEach(b => b.disabled = true);

            const isCorrect = selectedIndex === currentQuestion.correct;

            if (isCorrect) {
                // Marcar botón correcto en verde
                clickedBtn.classList.remove('bg-white', 'border-teal-200', 'text-slate-700');
                clickedBtn.classList.add('bg-emerald-500', 'border-emerald-600', 'text-white');

                // Ejecutar salto del diente
                triggerToothJump();
                sfx.playSuccess();

                // Puntuación con bonificación por rapidez y racha
                streak++;
                if (streak > bestStreak) bestStreak = streak;
                correctCount++;

                const speedBonus = Math.round(Math.max(0, (obstacle.x - tooth.x) / width) * 50);
                const pointsEarned = 100 + (streak - 1) * 20 + speedBonus;
                score += pointsEarned;

                obstacle.resolved = true;
                obstacle.speed = Math.max(obstacle.speed * 2.4, 380); // Acelera para pasar rápido bajo el diente

                showFeedback(`¡+${pointsEarned}! ✨`, 'text-emerald-400');
                spawnSparkles(tooth.x + tooth.width / 2, tooth.y + tooth.height / 2, '#34d399', 16);
                updateHUD();
            } else {
                // Marcar botón erróneo en rojo y resaltar la respuesta correcta
                clickedBtn.classList.remove('bg-white', 'border-teal-200', 'text-slate-700');
                clickedBtn.classList.add('bg-rose-500', 'border-rose-600', 'text-white');

                const correctBtn = buttons[currentQuestion.correct];
                if (correctBtn) {
                    correctBtn.classList.remove('bg-white', 'border-teal-200', 'text-slate-700');
                    correctBtn.classList.add('bg-emerald-100', 'border-emerald-400', 'text-emerald-800');
                }

                // El obstáculo embiste rápidamente al diente
                obstacle.speed = Math.max(obstacle.speed * 3.5, 520);
                showFeedback('¡Respuesta incorrecta!', 'text-rose-400');
            }
        }

        function triggerToothJump() {
            if (tooth.isGrounded) {
                tooth.vy = -530;
                tooth.isGrounded = false;
                tooth.emotion = 'jump';
                tooth.emotionTimer = 0.9;
                sfx.playJump();
            }
        }

        function handleObstacleCollision() {
            if (obstacle.resolved) return;
            obstacle.resolved = true;
            questionAnswered = true;

            // Deshabilitar botones si aún no había respondido (se acabó el tiempo)
            const buttons = optionsGrid.querySelectorAll('button');
            buttons.forEach((b, idx) => {
                b.disabled = true;
                if (currentQuestion && idx === currentQuestion.correct) {
                    b.classList.remove('bg-white', 'border-teal-200');
                    b.classList.add('bg-emerald-100', 'border-emerald-400');
                }
            });

            lives--;
            streak = 0;
            tooth.emotion = 'hurt';
            tooth.emotionTimer = 0.9;
            sfx.playHit();

            // Efecto visual de daño
            appContainer.classList.remove('animate-shake');
            void appContainer.offsetWidth;
            appContainer.classList.add('animate-shake');

            spawnSparkles(tooth.x + tooth.width / 2, tooth.y + tooth.height / 2, '#f43f5e', 18);
            showFeedback('¡Ouch! -1 ❤️', 'text-rose-500');
            updateHUD();

            if (lives <= 0) {
                setTimeout(() => endGame(false), 900);
            } else {
                setTimeout(() => {
                    if (gameState === 'PLAYING') spawnNextTurn();
                }, 1100);
            }
        }

        // Mostrar mensaje flotante animado sobre el canvas
        function showFeedback(text, colorClass) {
            floatingText.textContent = text;
            floatingText.className = `text-2xl sm:text-4xl font-extrabold drop-shadow-[0_3px_3px_rgba(0,0,0,0.45)] transform scale-100 transition-transform duration-300 ${colorClass}`;
            floatingFeedback.classList.remove('opacity-0');
            floatingFeedback.classList.add('opacity-100');

            setTimeout(() => {
                floatingFeedback.classList.remove('opacity-100');
                floatingFeedback.classList.add('opacity-0');
                floatingText.classList.remove('scale-100');
                floatingText.classList.add('scale-75');
            }, 950);
        }

        // Actualizar marcadores superiores (vidas, puntos y racha)
        function updateHUD() {
            const hearts = '❤️'.repeat(Math.max(0, lives)) + '🖤'.repeat(Math.max(0, 3 - lives));
            livesDisplay.textContent = hearts;
            scoreDisplay.textContent = score;
            streakDisplay.textContent = streak;
        }

        // Terminar juego (Game Over o Victoria al completar las 10 preguntas)
        function endGame(completedRound = false) {
            gameState = 'GAMEOVER';
            obstacle.active = false;

            if (completedRound) {
                sfx.playVictory();
                document.getElementById('endEmoji').textContent = '🏆🦷✨';
                const endTitle = document.getElementById('endTitle');
                endTitle.textContent = '¡Sonrisa Impecable!';
                endTitle.className = 'text-3xl font-extrabold text-emerald-500 mb-1';
                document.getElementById('endSubtitle').textContent = '¡Completaste las 10 preguntas sobre salud bucodental!';
            } else {
                sfx.playGameOver();
                document.getElementById('endEmoji').textContent = '😵‍💫🦷';
                const endTitle = document.getElementById('endTitle');
                endTitle.textContent = '¡Oh no! Muchas caries';
                endTitle.className = 'text-3xl font-extrabold text-rose-500 mb-1';
                document.getElementById('endSubtitle').textContent = '¡Pero hiciste un gran esfuerzo protegiendo la sonrisa!';
            }

            questionPanel.classList.add('hidden');
            dangerMeterContainer.classList.add('hidden');
            progressBadge.classList.add('hidden');
            progressBadge.classList.remove('flex');
            gameOverScreen.classList.remove('hidden');

            document.getElementById('finalScore').textContent = score;
            document.getElementById('finalCorrect').textContent = `${correctCount} / ${QUESTION_BANK.length}`;
            document.getElementById('finalStreak').textContent = bestStreak;
        }

        /**
         * ============================================================================
         * 6. SISTEMA DE PARTÍCULAS Y ACTUALIZACIÓN FÍSICA
         * ============================================================================
         */
        function spawnSparkles(x, y, color, count) {
            for (let i = 0; i < count; i++) {
                const angle = (Math.PI * 2 * i) / count + Math.random() * 0.4;
                const speed = 70 + Math.random() * 140;
                particles.push({
                    x,
                    y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - 40,
                    size: 4 + Math.random() * 5,
                    color,
                    alpha: 1,
                    life: 0.6 + Math.random() * 0.3
                });
            }
        }

        function update(dt) {
            // Desplazar suelo y nubes constantemente
            const worldSpeed = gameState === 'PLAYING' ? 160 : 60;
            groundOffset = (groundOffset + worldSpeed * dt) % 48;

            clouds.forEach(c => {
                c.x -= c.speed * dt;
                if (c.x < -80) c.x = width + 80;
            });

            // Física del diente
            const gravity = 1350;
            if (!tooth.isGrounded) {
                tooth.vy += gravity * dt;
                tooth.y += tooth.vy * dt;

                if (tooth.y >= groundY - tooth.height) {
                    tooth.y = groundY - tooth.height;
                    tooth.vy = 0;
                    tooth.isGrounded = true;
                }
            } else {
                tooth.runPhase += dt * 14;
            }

            if (tooth.emotionTimer > 0) {
                tooth.emotionTimer -= dt;
                if (tooth.emotionTimer <= 0) {
                    tooth.emotion = 'happy';
                }
            }

            // Actualizar obstáculo
            if (gameState === 'PLAYING' && obstacle.active) {
                obstacle.x -= obstacle.speed * dt;

                // Actualizar barra de peligro
                const totalDist = obstacle.startX - (tooth.x + tooth.width * 0.5);
                const currentDist = Math.max(0, obstacle.x - (tooth.x + tooth.width * 0.5));
                const pct = Math.min(100, Math.max(0, (currentDist / totalDist) * 100));
                dangerBar.style.width = `${pct}%`;

                if (pct < 30) {
                    dangerBar.className = 'h-full bg-rose-500 rounded-full';
                } else if (pct < 60) {
                    dangerBar.className = 'h-full bg-amber-400 rounded-full';
                } else {
                    dangerBar.className = 'h-full bg-emerald-400 rounded-full';
                }

                // Detección de colisión (hitbox ajustada para ser justa)
                const toothBox = {
                    left: tooth.x + 10,
                    right: tooth.x + tooth.width - 10,
                    top: tooth.y + 8,
                    bottom: tooth.y + tooth.height - 4
                };
                const obsBox = {
                    left: obstacle.x + 6,
                    right: obstacle.x + obstacle.width - 6,
                    top: obstacle.y + 6,
                    bottom: obstacle.y + obstacle.height
                };

                const overlaps =
                    toothBox.right > obsBox.left &&
                    toothBox.left < obsBox.right &&
                    toothBox.bottom > obsBox.top &&
                    toothBox.top < obsBox.bottom;

                if (overlaps && !obstacle.resolved) {
                    handleObstacleCollision();
                }

                // Cuando el obstáculo sale de la pantalla por la izquierda
                if (obstacle.x + obstacle.width < -20) {
                    obstacle.active = false;
                    if (obstacle.resolved && lives > 0 && questionAnswered) {
                        spawnNextTurn();
                    }
                }
            }

            // Actualizar partículas
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx * dt;
                p.y += p.vy * dt;
                p.vy += 260 * dt;
                p.life -= dt;
                p.alpha = Math.max(0, p.life);
                if (p.life <= 0) particles.splice(i, 1);
            }
        }

        /**
         * ============================================================================
         * 7. RENDERIZADO GRÁFICO EN CANVAS (Diente, Escenario y Obstáculos)
         * ============================================================================
         */
        function drawBackground() {
            // Cielo degradado limpio
            const skyGrad = ctx.createLinearGradient(0, 0, 0, groundY);
            skyGrad.addColorStop(0, '#bae6fd');
            skyGrad.addColorStop(1, '#f0f9ff');
            ctx.fillStyle = skyGrad;
            ctx.fillRect(0, 0, width, groundY);

            // Sol brillante con destellos suaves
            ctx.save();
            ctx.fillStyle = 'rgba(253, 224, 71, 0.35)';
            ctx.beginPath();
            ctx.arc(width - 65, 48, 34, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#fde047';
            ctx.beginPath();
            ctx.arc(width - 65, 48, 22, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();

            // Nubes esponjosas
            clouds.forEach(c => {
                ctx.save();
                ctx.translate(c.x, c.y);
                ctx.scale(c.scale, c.scale);
                ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
                ctx.beginPath();
                ctx.arc(0, 0, 18, 0, Math.PI * 2);
                ctx.arc(16, -5, 22, 0, Math.PI * 2);
                ctx.arc(34, 0, 17, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // Suelo estilo encía saludable rosada con brillo
            const gumGrad = ctx.createLinearGradient(0, groundY, 0, height);
            gumGrad.addColorStop(0, '#fda4af');
            gumGrad.addColorStop(0.25, '#fb7185');
            gumGrad.addColorStop(1, '#e11d48');
            ctx.fillStyle = gumGrad;
            ctx.fillRect(0, groundY, width, height - groundY);

            // Borde superior brillante de la encía
            ctx.fillStyle = '#fecdd3';
            ctx.fillRect(0, groundY, width, 6);

            // Ondas decorativas en movimiento sobre el suelo
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
            ctx.lineWidth = 3;
            ctx.beginPath();
            for (let x = -groundOffset; x < width + 48; x += 48) {
                ctx.moveTo(x, groundY + 18);
                ctx.quadraticCurveTo(x + 12, groundY + 12, x + 24, groundY + 18);
            }
            ctx.stroke();
        }

        function drawTooth() {
            const x = tooth.x;
            const y = tooth.y;
            const w = tooth.width;
            const h = tooth.height;

            ctx.save();

            // Sombra en el suelo proporcional a la altura del salto
            const distToGround = Math.max(0, (groundY - h) - y);
            const shadowScale = Math.max(0.35, 1 - distToGround / 180);
            ctx.fillStyle = 'rgba(136, 19, 55, 0.25)';
            ctx.beginPath();
            ctx.ellipse(x + w / 2, groundY + 4, (w * 0.45) * shadowScale, 6 * shadowScale, 0, 0, Math.PI * 2);
            ctx.fill();

            // Piernitas animadas corriendo
            const legSwing = tooth.isGrounded ? Math.sin(tooth.runPhase) * 7 : 6;
            ctx.strokeStyle = '#334155';
            ctx.lineWidth = 4.5;
            ctx.lineCap = 'round';

            // Pierna izquierda
            ctx.beginPath();
            ctx.moveTo(x + w * 0.34, y + h - 8);
            ctx.lineTo(x + w * 0.34 - legSwing, y + h + 4);
            ctx.stroke();

            // Pierna derecha
            ctx.beginPath();
            ctx.moveTo(x + w * 0.66, y + h - 8);
            ctx.lineTo(x + w * 0.66 + legSwing, y + h + 4);
            ctx.stroke();

            // Cuerpo anatómico de la muela (corona redondeada y dos raíces)
            const bounceY = tooth.isGrounded ? Math.abs(Math.sin(tooth.runPhase)) * -2.5 : 0;
            ctx.translate(0, bounceY);

            ctx.fillStyle = '#ffffff';
            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 2.5;

            ctx.beginPath();
            // Corona superior con hendidura suave
            ctx.moveTo(x + 8, y + 14);
            ctx.quadraticCurveTo(x + 8, y, x + w * 0.3, y);
            ctx.quadraticCurveTo(x + w * 0.5, y + 6, x + w * 0.7, y);
            ctx.quadraticCurveTo(x + w - 8, y, x + w - 8, y + 14);
            // Lado derecho y raíz derecha
            ctx.quadraticCurveTo(x + w, y + h * 0.55, x + w - 10, y + h - 4);
            ctx.quadraticCurveTo(x + w - 16, y + h + 2, x + w * 0.58, y + h - 14);
            // Arco entre raíces
            ctx.quadraticCurveTo(x + w * 0.5, y + h - 18, x + w * 0.42, y + h - 14);
            // Raíz izquierda y lado izquierdo
            ctx.quadraticCurveTo(x + 16, y + h + 2, x + 10, y + h - 4);
            ctx.quadraticCurveTo(x, y + h * 0.55, x + 8, y + 14);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            // Brillo de esmalte limpio
            ctx.fillStyle = '#e0f2fe';
            ctx.beginPath();
            ctx.ellipse(x + 15, y + 16, 4, 9, -0.25, 0, Math.PI * 2);
            ctx.fill();

            // Expresión facial del diente
            const eyeY = y + 23;
            if (tooth.emotion === 'hurt') {
                // Ojos en X
                ctx.strokeStyle = '#ef4444';
                ctx.lineWidth = 2.5;
                [x + 20, x + 36].forEach(ex => {
                    ctx.beginPath();
                    ctx.moveTo(ex - 3, eyeY - 3);
                    ctx.lineTo(ex + 3, eyeY + 3);
                    ctx.moveTo(ex + 3, eyeY - 3);
                    ctx.lineTo(ex - 3, eyeY + 3);
                    ctx.stroke();
                });
                // Boca triste
                ctx.beginPath();
                ctx.arc(x + 28, y + 38, 5, Math.PI, 0);
                ctx.stroke();
            } else {
                // Ojos alegres
                ctx.fillStyle = '#1e293b';
                ctx.beginPath();
                ctx.arc(x + 20, eyeY, 3.3, 0, Math.PI * 2);
                ctx.arc(x + 36, eyeY, 3.3, 0, Math.PI * 2);
                ctx.fill();

                // Destello en ojos
                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.arc(x + 19, eyeY - 1, 1.2, 0, Math.PI * 2);
                ctx.arc(x + 35, eyeY - 1, 1.2, 0, Math.PI * 2);
                ctx.fill();

                // Mejillas rosadas
                ctx.fillStyle = 'rgba(251, 113, 133, 0.45)';
                ctx.beginPath();
                ctx.ellipse(x + 14, eyeY + 6, 4, 2.5, 0, 0, Math.PI * 2);
                ctx.ellipse(x + 42, eyeY + 6, 4, 2.5, 0, 0, Math.PI * 2);
                ctx.fill();

                // Sonrisa
                ctx.strokeStyle = '#1e293b';
                ctx.lineWidth = 2.5;
                ctx.beginPath();
                if (tooth.emotion === 'jump') {
                    ctx.arc(x + 28, y + 31, 6, 0, Math.PI);
                    ctx.fillStyle = '#fb7185';
                    ctx.fill();
                } else {
                    ctx.arc(x + 28, y + 30, 6, 0.15 * Math.PI, 0.85 * Math.PI);
                }
                ctx.stroke();
            }

            ctx.restore();
        }

        function drawObstacle() {
            if (!obstacle.active) return;

            const x = obstacle.x;
            const y = obstacle.y;
            const w = obstacle.width;
            const h = obstacle.height;

            ctx.save();
            ctx.translate(x + w / 2, y + h / 2);

            const t = obstacle.info.type;

            if (t === 'candy') {
                // Caramelo envuelto
                ctx.fillStyle = '#f43f5e';
                ctx.beginPath();
                ctx.moveTo(-14, 0);
                ctx.lineTo(-24, -10);
                ctx.lineTo(-24, 10);
                ctx.closePath();
                ctx.fill();

                ctx.beginPath();
                ctx.moveTo(14, 0);
                ctx.lineTo(24, -10);
                ctx.lineTo(24, 10);
                ctx.closePath();
                ctx.fill();

                ctx.fillStyle = '#fb7185';
                ctx.beginPath();
                ctx.arc(0, 0, 15, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = '#ffe4e6';
                ctx.lineWidth = 2.5;
                ctx.beginPath();
                ctx.arc(0, 0, 8, 0, Math.PI * 1.4);
                ctx.stroke();
            } else if (t === 'soda') {
                // Lata de refresco
                ctx.fillStyle = '#2563eb';
                ctx.beginPath();
                ctx.roundRect(-13, -19, 26, 38, 5);
                ctx.fill();
                ctx.fillStyle = '#93c5fd';
                ctx.fillRect(-13, -5, 26, 10);
                ctx.fillStyle = '#cbd5e1';
                ctx.fillRect(-11, -21, 22, 3);
            } else if (t === 'germ') {
                // Bacteria caricaturesca
                ctx.fillStyle = '#8b5cf6';
                ctx.beginPath();
                ctx.arc(0, 2, 17, 0, Math.PI * 2);
                ctx.fill();

                // Púas alrededor
                for (let i = 0; i < 8; i++) {
                    const ang = (Math.PI * 2 * i) / 8;
                    ctx.beginPath();
                    ctx.arc(Math.cos(ang) * 18, 2 + Math.sin(ang) * 18, 4, 0, Math.PI * 2);
                    ctx.fill();
                }
                // Ojos traviesos
                ctx.fillStyle = '#fef08a';
                ctx.beginPath();
                ctx.arc(-6, 0, 4, 0, Math.PI * 2);
                ctx.arc(6, 0, 4, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#1e1b4b';
                ctx.beginPath();
                ctx.arc(-6, 0, 1.8, 0, Math.PI * 2);
                ctx.arc(6, 0, 1.8, 0, Math.PI * 2);
                ctx.fill();
            } else {
                // Pastelito dulce (Cupcake)
                ctx.fillStyle = '#d97706';
                ctx.beginPath();
                ctx.moveTo(-14, 2);
                ctx.lineTo(14, 2);
                ctx.lineTo(10, 20);
                ctx.lineTo(-10, 20);
                ctx.closePath();
                ctx.fill();

                ctx.fillStyle = '#f472b6';
                ctx.beginPath();
                ctx.arc(0, 0, 16, Math.PI, 0);
                ctx.fill();

                ctx.fillStyle = '#e11d48';
                ctx.beginPath();
                ctx.arc(0, -16, 4.5, 0, Math.PI * 2);
                ctx.fill();
            }

            ctx.restore();
        }

        function drawParticles() {
            particles.forEach(p => {
                ctx.save();
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });
        }

        function gameLoop(timestamp) {
            if (!lastTimestamp) lastTimestamp = timestamp;
            const dt = Math.min(0.05, (timestamp - lastTimestamp) / 1000);
            lastTimestamp = timestamp;

            update(dt);

            ctx.clearRect(0, 0, width, height);
            drawBackground();
            drawObstacle();
            drawTooth();
            drawParticles();

            requestAnimationFrame(gameLoop);
        }

        /**
         * ============================================================================
         * 8. EVENTOS DE INTERFAZ Y CONTROLES DE TECLADO
         * ============================================================================
         */
        document.getElementById('startBtn').addEventListener('click', startGame);
        document.getElementById('restartBtn').addEventListener('click', startGame);
        document.getElementById('menuBtn').addEventListener('click', () => {
            gameState = 'START';
            obstacle.active = false;
            gameOverScreen.classList.add('hidden');
            questionPanel.classList.add('hidden');
            dangerMeterContainer.classList.add('hidden');
            progressBadge.classList.add('hidden');
            progressBadge.classList.remove('flex');
            startScreen.classList.remove('hidden');
        });

        // Alternar silencio de sonido
        soundToggleBtn.addEventListener('click', () => {
            sfx.muted = !sfx.muted;
            soundIcon.textContent = sfx.muted ? '🔇' : '🔊';
        });

        // Soporte de teclado (A / B o 1 / 2 para responder rápidamente)
        window.addEventListener('keydown', (e) => {
            if (gameState !== 'PLAYING' || questionAnswered) return;
            const key = e.key.toUpperCase();
            const map = { '1': 0, 'A': 0, '2': 1, 'B': 1 };
            if (key in map) {
                const buttons = optionsGrid.querySelectorAll('button');
                if (buttons[map[key]]) {
                    buttons[map[key]].click();
                }
            }
        });

        // Inicialización al cargar ventana
        window.onload = function () {
            resizeCanvas();
            initDecorations();
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
